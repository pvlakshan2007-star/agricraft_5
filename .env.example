# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
# Option A: Full Connection String URI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agricraft

# Option B: Individual Connection Parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=agricraft

# Optional API Security Key (for protected administrative endpoints)
API_KEY=agri_craft_secret_key_demo
